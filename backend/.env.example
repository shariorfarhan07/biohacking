# Copy to .env and fill in real values before running against live services.

ENV=development

# SQLite for local dev. Swap for a postgresql+psycopg://... URL in production —
# every model uses SQLAlchemy 2.0 cross-dialect types, so no code changes needed.
DATABASE_URL=sqlite:///./app.db

# JWT signing secrets — generate real random values for production
# (e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`).
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# Stripe (test mode keys — https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Public frontend origin — used for CORS and Stripe redirect URLs.
FRONTEND_URL=http://localhost:3000

# Everfit has no public self-serve API today, so this stays "mock" until a real
# integration is available. See app/services/everfit/.
EVERFIT_PROVIDER=mock
EVERFIT_API_KEY=

# Programme slug assigned when no assignment rule matches a customer's onboarding
# answers — must always resolve to a real, active Programme row.
DEFAULT_PROGRAMME_SLUG=general-foundations
